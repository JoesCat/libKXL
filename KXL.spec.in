%define name @PACKAGE@
%define version  @VERSION@
%define release  1

Summary      : KXL -- a visual & sound library
Name         : %{name}
Version      : %{version}
Release      : %{release}
Source       : https://github.com/Quipyowert2/libKXL/archive/%{version}/%{name}-%{version}.tar.gz
License      : GPLv2+
Group        : System Environment/Libraries
URL          : https://github.com/Quipyowert2/libKXL
BuildRoot    : /var/tmp/%{name}-%{version}-root
Requires     : libpulse-simple.so.0()(64bit)
BuildRequires: autoconf
BuildRequires: automake
BuildRequires: gcc
BuildRequires: make

%description
Kacchan X Windows System Liblary (KXL) is a visual & sound library.

%prep
rm -rf ${RPM_BUILD_ROOT}

%setup -q

%build
./configure --prefix=%{_prefix} --libdir %{_libdir}
make CFLAGS+=-DUSE_PULSEAUDIO

%install
rm -rf $RPM_BUILD_ROOT
make DESTDIR=$RPM_BUILD_ROOT install

%clean
rm -rf $RPM_BUILD_ROOT

%files
%defattr(-,root,root)
%doc COPYING ChangeLog README
%doc docs/*
%{_prefix}/share/aclocal/KXL.m4
%{_prefix}/include/*
%{_prefix}/%{_lib}/*

%changelog

